package views

templ Profile(isLoggedIn bool) {
	<div class="profile-card" id="profile-card" style="display: none;" data-has-session={ boolToString(isLoggedIn) }></div>
}

func boolToString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

templ ProfileTemplates() {
	<template id="tpl-pc-guest">
		<div class="pc-body">
			<div class="pc-section">
				<p class="pc-desc">Добро пожаловать! Вы можете войти через</p>
				<div class="pc-oauth-buttons" id="pc-oauth-buttons">
					<a href="/auth/google/login" class="pc-btn pc-btn-oauth pc-btn-google">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 32 32"><path fill="currentColor" d="M16.318 13.714v5.484h9.078c-.37 2.354-2.745 6.901-9.078 6.901c-5.458 0-9.917-4.521-9.917-10.099s4.458-10.099 9.917-10.099c3.109 0 5.193 1.318 6.38 2.464l4.339-4.182C24.251 1.584 20.641.001 16.318.001c-8.844 0-16 7.151-16 16s7.156 16 16 16c9.234 0 15.365-6.49 15.365-15.635c0-1.052-.115-1.854-.255-2.651z"></path></svg>
						<span>Google</span>
					</a>
					<a href="/auth/github/login" class="pc-btn pc-btn-oauth pc-btn-github">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 32 32"><path fill="currentColor" d="M16 .396c-8.839 0-16 7.167-16 16c0 7.073 4.584 13.068 10.937 15.183c.803.151 1.093-.344 1.093-.772c0-.38-.009-1.385-.015-2.719c-4.453.964-5.391-2.151-5.391-2.151c-.729-1.844-1.781-2.339-1.781-2.339c-1.448-.989.115-.968.115-.968c1.604.109 2.448 1.645 2.448 1.645c1.427 2.448 3.744 1.74 4.661 1.328c.14-1.031.557-1.74 1.011-2.135c-3.552-.401-7.287-1.776-7.287-7.907c0-1.751.62-3.177 1.645-4.297c-.177-.401-.719-2.031.141-4.235c0 0 1.339-.427 4.4 1.641a15.4 15.4 0 0 1 4-.541c1.36.009 2.719.187 4 .541c3.043-2.068 4.381-1.641 4.381-1.641c.859 2.204.317 3.833.161 4.235c1.015 1.12 1.635 2.547 1.635 4.297c0 6.145-3.74 7.5-7.296 7.891c.556.479 1.077 1.464 1.077 2.959c0 2.14-.02 3.864-.02 4.385c0 .416.28.916 1.104.755c6.4-2.093 10.979-8.093 10.979-15.156c0-8.833-7.161-16-16-16z"></path></svg>
						<span>GitHub</span>
					</a>
					<a href="/auth/yandex/login" class="pc-btn pc-btn-oauth pc-btn-yandex">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 16 16"
							style="overflow: visible"
						>
							<g transform="translate(8 8) scale(1.2) translate(-8 -8)">
								<path
									fill="currentColor"
									fill-rule="evenodd"
									d="M13.5 8a5.5 5.5 0 1 1-11 0a5.5 5.5 0 0 1 11 0M15 8A7 7 0 1 1 1 8a7 7 0 0 1 14 0M6.136 5.103a.75.75 0 0 0-1.272.795l2.044 3.27c.223.357.342.77.342 1.192v1.14a.75.75 0 0 0 1.5 0v-1.14a3.75 3.75 0 0 0-.57-1.987zm5 .795a.75.75 0 1 0-1.272-.795L8.77 6.853a.75.75 0 0 0 1.272.795z"
									clip-rule="evenodd"
								></path>
							</g>
						</svg>
						<span>Yandex</span>
					</a>
				</div>
				<div class="pc-agreements">
					<p class="pc-legal-note">
						Входя в аккаунт, вы подтверждаете, что вам исполнилось 18 лет,
						принимаете <a href="/terms" target="_blank">Пользовательское соглашение</a> и
						<a href="/privacy" target="_blank">Политику конфиденциальности</a>
					</p>
				</div>
			</div>
		</div>
	</template>
	<template id="tpl-pc-guest-skeleton">
		<div class="pc-body">
			<div class="pc-section">
				<span class="pc-skeleton pc-skeleton-desc"></span>
				<div class="pc-oauth-buttons">
					<span class="pc-skeleton pc-skeleton-oauth-btn"></span>
					<span class="pc-skeleton pc-skeleton-oauth-btn"></span>
					<span class="pc-skeleton pc-skeleton-oauth-btn"></span>
				</div>
				<div class="pc-agreements">
					<span class="pc-skeleton pc-skeleton-legal"></span>
				</div>
			</div>
		</div>
	</template>
	<template id="tpl-pc-skeleton">
		<div class="pc-body">
			<div class="pc-profile">
				<div class="pc-avatar-wrapper">
					<div class="pc-avatar pc-skeleton"></div>
				</div>
				<div class="pc-info">
					<div class="pc-name-row">
						<span class="pc-skeleton pc-skeleton-name"></span>
					</div>
					<div class="pc-meta">
						<span class="pc-skeleton pc-skeleton-date"></span>
					</div>
				</div>
			</div>
			<div class="pc-footer">
				<span class="pc-skeleton pc-skeleton-logout"></span>
				<span class="pc-skeleton pc-skeleton-logout"></span>
			</div>
		</div>
	</template>
	<template id="tpl-pc-profile">
		<div class="pc-body">
			<div class="pc-profile">
				<div class="pc-avatar-wrapper">
					<img src="" alt="" class="pc-avatar" id="pc-avatar-img" data-field="avatarUrl"/>
					<div class="pc-avatar-overlay" id="pc-avatar-overlay">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg>
					</div>
					<input type="file" id="pc-avatar-input" accept="image/jpeg,image/png" style="display:none"/>
				</div>
				<div class="pc-info">
					<div class="pc-name-row">
						<span class="pc-name" id="pc-name-text" data-field="displayName"></span>
						<input type="text" class="pc-name-input" id="pc-name-input" maxlength="15" style="display:none"/>
					</div>
					<div class="pc-meta">
						<span class="pc-meta-date">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 13H3"></path><path d="M16 17H3"></path><path d="m7.2 7.9-3.388 2.5A2 2 0 0 0 3 12.01V20a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-8.654c0-2-2.44-6.026-6.44-8.026a1 1 0 0 0-1.082.057L10.4 5.6"></path><circle cx="9" cy="7" r="2"></circle></svg>
							<span data-field="createdAt"></span>
						</span>
					</div>
				</div>
			</div>
			<div class="pc-footer">
				<a href="/comments" class="pc-btn pc-btn-action">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
					<span>Мои комментарии</span>
				</a>
				<button class="pc-btn pc-btn-action pc-btn-danger" id="pc-logout">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path></svg>
					<span>Выйти</span>
				</button>
			</div>
		</div>
	</template>
}
