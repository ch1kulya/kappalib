package views

templ Profile() {
	<div class="profile-card" id="profile-card" style="display: none;"></div>
}

templ ProfileTemplates() {
	<template id="tpl-pc-guest">
	    <div class="pc-body">
	        <div class="pc-section">
	            <p class="pc-desc">Создать аккаунт? Ваш прогресс сохранится</p>
	            <div id="turnstile-container" class="pc-turnstile-container"></div>
	            <div class="pc-agreements">
	                <label class="pc-checkbox-label">
	                    <input type="checkbox" id="pc-agree-age" class="pc-checkbox"/>
	                    <span>Мне исполнилось 18 лет</span>
	                </label>
	                <label class="pc-checkbox-label">
	                    <input type="checkbox" id="pc-agree-terms" class="pc-checkbox"/>
	                    <span>Я принимаю <a href="/terms" target="_blank">Пользовательское соглашение</a></span>
	                </label>
	                <label class="pc-checkbox-label">
	                    <input type="checkbox" id="pc-agree-privacy" class="pc-checkbox"/>
	                    <span>Я согласен с <a href="/privacy" target="_blank">Политикой конфиденциальности</a></span>
	                </label>
	            </div>
	            <button class="pc-btn pc-btn-primary" id="pc-create" disabled>Создать аккаунт</button>
	        </div>
	        <div class="pc-divider"><span>или</span></div>
	        <div class="pc-section">
	            <p class="pc-desc">Уже есть аккаунт?</p>
	            <div class="pc-input-row">
	                <div class="pc-input-wrapper">
	                    <input type="text" class="pc-input" id="pc-sync-input" placeholder="Код" maxlength="24" spellcheck="false" autocomplete="one-time-code"/>
	                </div>
	                <button class="pc-btn pc-btn-outline" id="pc-login">Войти</button>
	            </div>
	            <div id="pc-error" class="pc-error"></div>
	        </div>
	    </div>
	</template>
	<template id="tpl-pc-skeleton">
		<div class="pc-body">
			<div class="pc-profile">
				<div class="pc-avatar-wrapper">
					<div class="pc-avatar pc-skeleton"></div>
				</div>
				<div class="pc-info">
					<div class="pc-name-row">
						<span class="pc-skeleton pc-skeleton-name"></span>
					</div>
					<div class="pc-meta">
						<span class="pc-skeleton pc-skeleton-id"></span>
						<span class="pc-skeleton pc-skeleton-date"></span>
					</div>
				</div>
			</div>
			<div class="pc-section">
				<p class="pc-desc pc-skeleton pc-skeleton-text"></p>
				<div class="pc-skeleton pc-skeleton-btn"></div>
			</div>
			<div class="pc-footer">
				<span class="pc-skeleton pc-skeleton-link"></span>
				<span class="pc-skeleton pc-skeleton-link"></span>
			</div>
		</div>
	</template>
	<template id="tpl-pc-profile">
	    <div class="pc-body">
	        <div class="pc-profile">
	            <div class="pc-avatar-wrapper">
	                <img src="" alt="" class="pc-avatar" id="pc-avatar-img" data-field="avatarUrl"/>
	                <div class="pc-avatar-overlay" id="pc-avatar-overlay">
	                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg>
	                </div>
	                <input type="file" id="pc-avatar-input" accept="image/jpeg,image/png" style="display:none"/>
	            </div>
	            <div class="pc-info">
	                <div class="pc-name-row">
	                    <span class="pc-name" id="pc-name-text" data-field="displayName"></span>
	                    <button class="pc-name-edit" id="pc-name-edit" aria-label="Изменить имя">
	                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"></path></svg>
	                    </button>
	                    <input type="text" class="pc-name-input" id="pc-name-input" maxlength="15" style="display:none"/>
	                </div>
	                <div class="pc-meta">
	                    <span class="pc-id badge" data-field="profileId"></span>
	                    <span data-field="createdAt"></span>
	                </div>
	            </div>
	        </div>
	        <div class="pc-section">
	            <p class="pc-desc">Временный код для авторизации</p>
				<div class="pc-code-row" id="pc-code-row" style="display: none;">
			        <div class="pc-code-result">
			            <span class="pc-code" id="pc-code-text"></span>
			        </div>
			        <button class="pc-btn pc-btn-copy" id="pc-code-copy" aria-label="Копировать код">
			            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
			        </button>
			    </div>
				<p class="pc-code-hint" id="pc-code-hint" style="display: none;"></p>
	            <div id="pc-code-area"></div>
	            <div class="pc-code-controls" id="pc-code-controls">
	                <div class="dropdown pc-ttl-dropdown" id="pc-ttl-dropdown">
	                    <button class="dropdown-btn" type="button" aria-haspopup="listbox" aria-expanded="false">
	                        <span class="js-dropdown-label">15 минут</span>
	                        <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
	                    </button>
	                    <div class="dropdown-menu" role="listbox">
	                        <div class="dropdown-menu-inner">
	                            <button class="dropdown-item selected" data-value="15m" role="option" aria-selected="true">
	                                <span>15 минут</span>
	                                <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
	                            </button>
	                            <button class="dropdown-item" data-value="1h" role="option" aria-selected="false">
	                                <span>1 час</span>
	                                <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
	                            </button>
	                            <button class="dropdown-item" data-value="24h" role="option" aria-selected="false">
	                                <span>24 часа</span>
	                                <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
	                            </button>
	                            <button class="dropdown-item" data-value="7d" role="option" aria-selected="false">
	                                <span>7 дней</span>
	                                <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
	                            </button>
	                            <button class="dropdown-item" data-value="30d" role="option" aria-selected="false">
	                                <span>30 дней</span>
	                                <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
	                            </button>
	                            <button class="dropdown-item" data-value="12mo" role="option" aria-selected="false">
	                                <span>12 месяцев</span>
	                                <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
	                            </button>
	                        </div>
	                    </div>
	                </div>
	                <button class="pc-btn pc-btn-get-code" id="pc-get-code">Получить</button>
	            </div>
	        </div>
	        <div class="pc-footer">
	            <button class="pc-btn pc-btn-text" id="pc-logout">Выйти</button>
	            <button class="pc-btn pc-btn-danger-text" id="pc-delete">Удалить</button>
	        </div>
	    </div>
	</template>
}
