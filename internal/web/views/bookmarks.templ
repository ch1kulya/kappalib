package views

templ Bookmarks(props BaseProps) {
	@Base(props) {
		<div class="chapters-header" style="margin-bottom: 1.5rem;">
			<h2 style="margin: 0;">Закладки</h2>
		</div>
		<div id="bm-content">
			<div class="mc-empty" id="bm-empty" style="display: none;">
				<p>У вас пока нет закладок</p>
			</div>
			<div class="mc-loading" id="bm-loading">Загрузка закладок...</div>
			<div class="bm-categories" id="bm-categories"></div>
		</div>
		<template id="tpl-bm-category">
			<details class="bm-category">
				<summary class="bm-category-summary">
					<svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
					<span class="bm-category-name" data-field="name"></span>
					<span class="bm-category-count" data-field="count"></span>
					<div class="comment-menu bm-category-menu">
						<button class="comment-menu-btn" type="button" aria-label="Действия" aria-haspopup="true" aria-expanded="false">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg>
						</button>
						<div class="comment-dropdown-menu">
							<button class="comment-dropdown-item bm-category-rename" type="button">
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path><path d="m15 5 4 4"></path></svg>
								<span>Переименовать</span>
							</button>
							<button class="comment-dropdown-item danger bm-category-delete-item" type="button">
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
								<span>Удалить</span>
							</button>
						</div>
					</div>
				</summary>
				<div class="bm-items"></div>
			</details>
		</template>
		<template id="tpl-bm-item">
			<div class="bm-item">
				<div class="bm-item-top">
					<span class="bm-item-source" data-field="source"></span>
					<div class="bm-item-side">
						<span class="bm-item-date" data-field="date"></span>
						<div class="comment-menu bm-item-menu">
							<button class="comment-menu-btn" type="button" aria-label="Действия" aria-haspopup="true" aria-expanded="false">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg>
							</button>
							<div class="comment-dropdown-menu">
								<button class="comment-dropdown-item bm-item-edit" type="button">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path><path d="m15 5 4 4"></path></svg>
									<span>Редактировать</span>
								</button>
								<button class="comment-dropdown-item danger bm-item-delete" type="button">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
									<span>Удалить</span>
								</button>
							</div>
						</div>
					</div>
				</div>
				<a href="" class="bm-item-name-link">
					<span class="bm-item-name" data-field="name"></span>
				</a>
			</div>
		</template>
	}
}
