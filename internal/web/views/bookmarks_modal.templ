package views

templ BookmarkModal() {
	<div class="settings-card" id="bookmark-card" style="display: none;"></div>
}

templ BookmarkModalTemplates() {
	<template id="tpl-bookmark-form">
		<div class="settings-body">
			<div class="settings-section">
				<div class="settings-label">Категория</div>
				<div class="dropdown settings-dropdown" id="bm-category-dropdown">
					<button class="dropdown-btn" type="button" aria-haspopup="listbox" aria-expanded="false">
						<span class="js-dropdown-label" id="bm-category-label">Избранное</span>
						<svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
					</button>
					<div class="dropdown-menu" role="listbox">
						<div class="dropdown-menu-inner-bm" id="bm-category-options"></div>
					</div>
				</div>
			</div>
			<div class="settings-section">
				<div class="settings-label">Значение</div>
				<textarea class="bm-form-textarea" id="bm-form-value" maxlength="100" rows="1" placeholder="Ваша заметка..."></textarea>
				<div class="comment-form-footer">
					<span class="comment-char-counter" id="bm-char-counter">0/100</span>
					<div class="bm-form-actions">
						<button class="comment-reply-cancel-btn" id="bm-form-delete" style="display: none;">Удалить</button>
						<button class="action-btn comment-submit-btn" id="bm-form-save" disabled>Сохранить</button>
					</div>
				</div>
			</div>
		</div>
	</template>
	<template id="tpl-bookmark-category-option">
		<button class="dropdown-item" data-value="" role="option" aria-selected="false">
			<span data-field="label"></span>
			<svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
		</button>
	</template>
	<template id="tpl-bookmark-category-new">
		<hr class="dropdown-divider"/>
		<div class="dropdown-item-new-wrap">
			<button class="dropdown-item dropdown-item-new" data-no-select="true" type="button">
				<span class="bm-category-new-label">Новая категория</span>
				<svg class="plus-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
			</button>
			<div class="dropdown-item dropdown-item-new bm-category-input-row" style="display: none;">
				<input type="text" class="bm-category-input" maxlength="15" placeholder="Название"/>
				<svg class="plus-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
			</div>
		</div>
	</template>
}
