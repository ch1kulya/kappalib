package views

templ BookmarkModal() {
	<div class="settings-card" id="bookmark-card" style="display: none;"></div>
}

templ BookmarkModalTemplates() {
	<template id="tpl-bookmark-form">
		<div class="settings-body">
			<div class="settings-section">
				<div class="settings-label">Категория</div>
				<div class="dropdown settings-dropdown" id="bm-category-dropdown">
					<button class="dropdown-btn" type="button" aria-haspopup="listbox" aria-expanded="false">
						<span class="js-dropdown-label" id="bm-category-label">Избранное</span>
						<svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
					</button>
					<div class="dropdown-menu" role="listbox">
						<div class="dropdown-menu-inner-bm" id="bm-category-options"></div>
					</div>
				</div>
				<input type="text" class="bm-input" id="bm-category-new-input" style="display: none; margin-top: 0.5rem;" placeholder="Название новой категории" maxlength="50"/>
			</div>
			<div class="settings-section">
				<div class="settings-label">Название</div>
				<input type="text" class="bm-input" id="bm-form-name" maxlength="100"/>
			</div>
			<div class="settings-section bm-form-actions">
				<button class="action-btn btn-primary" id="bm-form-save">Сохранить</button>
				<button class="action-btn" id="bm-form-delete" style="display: none;">Удалить</button>
			</div>
		</div>
	</template>
	<template id="tpl-bookmark-category-option">
		<button class="dropdown-item" data-value="" role="option" aria-selected="false">
			<span data-field="label"></span>
			<svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
		</button>
	</template>
	<template id="tpl-bookmark-category-new">
		<button class="dropdown-item dropdown-item-new" data-value="__new__" role="option" aria-selected="false">
			<span>+ Добавить новую категорию</span>
		</button>
	</template>
}
