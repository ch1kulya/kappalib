package views

templ CommentsSection(chapterId string) {
	<div class="comments-section" id="comments-section" data-chapter-id={ chapterId }>
		<div class="comments-header">
			<h3>Комментарии <span class="comments-count">0</span></h3>
		</div>
		<div class="comment-form-wrapper"></div>
		<div class="comments-list"></div>
		<div class="comments-pagination pagination"></div>
	</div>
}

templ MyComments(props BaseProps) {
	@Base(props) {
		<div class="chapters-header" style="margin-bottom: 1.5rem;">
			<h2 style="margin: 0;">Мои комментарии <span class="mc-count" id="mc-count"></span></h2>
		</div>
		<div id="mc-stats" class="mc-stats"></div>
		<div id="mc-content">
			<div class="mc-empty" id="mc-empty" style="display: none;">
				<p>У вас пока нет комментариев</p>
			</div>
			<div class="mc-loading" id="mc-loading" style="display: none;">Загрузка комментариев...</div>
			<div class="mc-list" id="mc-list"></div>
			<div class="mc-pagination pagination" id="mc-pagination"></div>
		</div>
	}
}
