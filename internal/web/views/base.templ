package views

import (
	"fmt"

	"github.com/ch1kulya/kappalib/internal/models"
)

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html
		lang="ru"
		if props.ReaderSettings.Theme != "auto" {
			data-theme={ props.ReaderSettings.Theme }
		}
		if props.ReaderSettings.ColorScheme != "" && props.ReaderSettings.ColorScheme != "default" {
			data-scheme={ props.ReaderSettings.ColorScheme }
		}
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
			<title>{ props.Title }</title>
			<meta name="description" content={ props.Description }/>
			<link rel="canonical" href={ props.Canonical }/>
			if props.Schema != "" {
				@templ.Raw(props.Schema)
			}
			if props.PrefetchURL != "" {
				<link rel="prefetch" href={ props.PrefetchURL } as="document"/>
				@templ.Raw(fmt.Sprintf(`<script type="speculationrules" nonce="%s">{"prerender":[{"source":"list","urls":[%q]}]}</script>`, templ.GetNonce(ctx), props.PrefetchURL))
			}
			<link rel="preload" href="/assets/fonts/InterVariable.woff2?v=4.1" as="font" type="font/woff2" crossorigin/>
			<link rel="preconnect" href="https://cdn.kappalib.rip"/>
			<link rel="preconnect" href="https://cdn.jsdelivr.net"/>
			if props.IsMyCommentsPage {
				<link rel="preconnect" href="https://fonts.googleapis.com"/>
				<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
				<link href="https://fonts.googleapis.com/css2?family=Datatype:wght@400;500;700&display=swap" rel="stylesheet"/>
			}
			<!-- Favicon -->
			<link rel="icon" type="image/x-icon" href={ BrandIconURL(props.ReaderSettings.ColorScheme, "favicon.ico") } data-brand-icon="favicon.ico"/>
			<link rel="icon" type="image/png" sizes="16x16" href={ BrandIconURL(props.ReaderSettings.ColorScheme, "favicon-16x16.png") } data-brand-icon="favicon-16x16.png"/>
			<link rel="icon" type="image/png" sizes="32x32" href={ BrandIconURL(props.ReaderSettings.ColorScheme, "favicon-32x32.png") } data-brand-icon="favicon-32x32.png"/>
			<link rel="apple-touch-icon" sizes="180x180" href={ BrandIconURL(props.ReaderSettings.ColorScheme, "apple-touch-icon.png") } data-brand-icon="apple-touch-icon.png"/>
			if !props.IsChapterPage || props.Novel == nil {
				switch props.ReaderSettings.Theme {
					case "light":
						<link rel="preload" href={ BrandIconURL(props.ReaderSettings.ColorScheme, "logo.png") } as="image"/>
					case "dark":
						<link rel="preload" href={ BrandIconURL(props.ReaderSettings.ColorScheme, "dark/logo.png") } as="image"/>
					default:
						<link rel="preload" href={ BrandIconURL(props.ReaderSettings.ColorScheme, "logo.png") } as="image" media="(prefers-color-scheme: light)"/>
						<link rel="preload" href={ BrandIconURL(props.ReaderSettings.ColorScheme, "dark/logo.png") } as="image" media="(prefers-color-scheme: dark)"/>
				}
			}
			<meta property="og:type" content="website"/>
			<meta property="og:site_name" content="kappalib"/>
			<meta property="og:locale" content="ru_RU"/>
			<meta property="og:title" content={ props.Title }/>
			<meta property="og:description" content={ props.Description }/>
			<meta property="og:url" content={ props.Canonical }/>
			if props.OGImage != "" {
				<meta property="og:image" content={ props.OGImage }/>
				<meta name="twitter:card" content="summary"/>
				<meta name="twitter:image" content={ props.OGImage }/>
			} else {
				<meta name="twitter:card" content="summary"/>
			}
			<link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" media="print" class="lazy-font"/>
			<link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/npm/noto-sans-cjk-jp@1.0.1/index.min.css" media="print" class="lazy-font"/>
			<link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/npm/@ibm/plex-mono@1.1.0/css/ibm-plex-mono-all.min.css" media="print" class="lazy-font"/>
			if props.IsChapterPage && props.ReaderSettings.FontFamily != "default" {
				if fontURL := GetFontURL(props.ReaderSettings.FontFamily); fontURL != "" {
					<link rel="stylesheet" crossorigin href={ fontURL }/>
				}
			}
			<link rel="stylesheet" href={ fmt.Sprintf("/assets/dist/styles/main.css?v=%s", props.Version) }/>
			@initUmami(props.ReaderSettings.ColorScheme)
		</head>
		<body>
			<div id="app">
				@Header(props)
				if props.GlobalAnnouncement != nil {
					@GlobalAnnouncementBar(props.GlobalAnnouncement)
				}
				@AgeModal(props)
				@Profile(props.IsLoggedIn)
				@Settings()
				@BookmarkModal()
				@ProfileTemplates()
				@SettingsTemplates()
				@BookmarkModalTemplates()
				<div class="container">
					{ children... }
				</div>
				@Footer(props)
			</div>
			<script type="module" src={ fmt.Sprintf("/assets/dist/app.js?v=%s", props.Version) }></script>
		</body>
	</html>
}

templ Header(props BaseProps) {
	<div class="header-backdrop" id="header-backdrop"></div>
	<header class={ "header", templ.KV("static", props.IsChapterPage) } id="main-header">
		<div class="header-content">
			if props.IsChapterPage && props.Novel != nil {
				<a href={ templ.SafeURL("/" + props.Novel.ID) } class="header-left"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="header-logo"><path d="M9 14 4 9l5-5"></path><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11"></path></svg></a>
				<div class="header-buttons">
					<button class="header-right js-bookmark-toggle" id="header-bookmark-btn" aria-label="Добавить закладку">
						@IconBookmark("header-profile-icon")
					</button>
					<button class="header-right" id="header-settings-btn" aria-label="Настройки">
						@IconSettings("header-profile-icon")
					</button>
					<button class="header-right" id="header-profile-btn" aria-label="Профиль">
						@IconUser("header-profile-icon")
					</button>
				</div>
			} else {
				if props.IsHomePage {
					<h1 style="margin:0; font-size: inherit;">
						<a href="/" class="header-left header-brand">
							<span class="visually-hidden">kappalib — бесплатная библиотека веб-новелл и ранобэ</span>
						</a>
					</h1>
				} else {
					<a href="/" class="header-left header-brand">
						<span class="visually-hidden">kappalib</span>
					</a>
				}
				<div class="search-bar" id="search-component">
					<div class="search-input-wrapper">
						@IconSearch("search-icon")
						<input type="text" placeholder="Поиск..." id="search-input" autocomplete="off" maxlength="50"/>
					</div>
					<div class="search-results" id="search-results" style="display: none;"></div>
				</div>
				<button class="header-right" id="header-profile-btn" aria-label="Профиль">
					@IconUser("header-profile-icon")
				</button>
			}
		</div>
	</header>
}

templ Footer(props BaseProps) {
	<footer class="footer">
		<div class="footer-content">
			<div class="footer-section">
				<h4>Полезное</h4>
				<nav class="footer-nav">
					<a href="https://stats.kappalib.rip/q/LNdWv7KGd" target="_blank" rel="noopener noreferrer">
						Добавить новеллу
						@IconExternalLink()
					</a>
					<a href="https://stats.kappalib.rip/q/MG9BJDFXa" target="_blank" rel="noopener noreferrer">
						Сообщить об ошибке
						@IconExternalLink()
					</a>
					<a href="/markdown">Шпаргалка по форматированию</a>
				</nav>
				<h4>Документы</h4>
				<nav class="footer-nav">
					<a href="/terms">Пользовательское соглашение</a>
					<a href="/privacy">Политика конфиденциальности</a>
					<a href="/copyright">Защита авторских прав</a>
					<a href="/dmca">DMCA Policy</a>
				</nav>
			</div>
			<div class="footer-section">
				<h4>Сервис</h4>
				<nav class="footer-nav">
					<a href="https://status.kappalib.rip" target="_blank" rel="noopener noreferrer">
						Статус
						@IconExternalLink()
					</a>
					<a href="/license">Лицензия</a>
					<a href="https://github.com/ch1kulya/kappalib" target="_blank" rel="noopener noreferrer">
						Исходный код
						@IconExternalLink()
					</a>
					<a href="https://pay.cloudtips.ru/p/4a6c00ef" target="_blank" rel="noopener noreferrer">
						Чаевые разработчику
						@IconExternalLink()
					</a>
				</nav>
				<h4>Правообладателям</h4>
				<p class="footer-disclaimer">
					Если материал в сервисе kappalib нарушает ваши авторские права — направьте уведомление на
					<a href="mailto:support@kappalib.rip">support@kappalib.rip</a>
				</p>
			</div>
		</div>
		<div class="footer-bottom">
			<div class="copyright">&copy; 2025-2026</div>
			<a href="https://status.kappalib.rip" target="_blank" rel="noopener noreferrer" class="status-widget" id="status-widget">
				<span class="status-dot"></span>
				<span class="status-text">Загрузка статуса...</span>
			</a>
		</div>
	</footer>
}

script showAgeModalScript() {
	window.isAdultContent = true;
	(function() {
		try {
			var isConfirmed = localStorage.getItem("ageConfirmed") === "true" ||
				sessionStorage.getItem("ageConfirmed") === "true";
			if (!isConfirmed) {
				var modal = document.getElementById("age-modal");
				if (modal) modal.style.display = "flex";
				document.body.style.overflow = "hidden";
			}
		} catch(e) {}
	})();
}

templ AgeModal(props BaseProps) {
	<div class="modal-overlay" id="age-modal" style="display: none;">
		<div class="modal-content">
			<h3>Возрастное ограничение</h3>
			<p>
				Эта новелла имеет возрастной рейтинг <span class="text-danger">18+</span>.
				Продолжая, вы подтверждаете, что достигли совершеннолетия.
			</p>
			<label class="age-checkbox-label">
				<input type="checkbox" id="age-remember"/> Больше не показывать
			</label>
			<div class="modal-actions">
				<button class="action-btn" id="age-back">На главную</button>
				<button class="action-btn btn-confirm" id="age-confirm">Мне есть 18</button>
			</div>
		</div>
	</div>
	if props.IsAdult {
		@showAgeModalScript()
	}
}

script initUmami(colorScheme string) {
	(function() {
		function load() {
			var s1 = document.createElement("script");
			s1.src = "https://stats.kappalib.rip/script.js";
			s1.setAttribute("data-website-id", "752a2779-b8fc-48cf-9a14-68cf76c63ecd");
			if (colorScheme && colorScheme !== "default") {
				s1.setAttribute("data-tag", colorScheme);
			}
			s1.setAttribute("data-performance", "true");
			s1.onload = function() {
				window.dispatchEvent(new CustomEvent("umami:ready"));
			};
			document.head.appendChild(s1);

			var s2 = document.createElement("script");
			s2.src = "https://stats.kappalib.rip/recorder.js";
			s2.setAttribute("data-website-id", "752a2779-b8fc-48cf-9a14-68cf76c63ecd");
			document.head.appendChild(s2);
		}

		if (document.prerendering) {
			document.addEventListener("prerenderingchange", load, { once: true });
		} else {
			load();
		}
	})();
}

templ announcementTrack(text string) {
	<div class="global-announcement-track">
		for range 10 {
			<span class="global-announcement-item">{ text }</span>
		}
		for range 10 {
			<span class="global-announcement-item" aria-hidden="true">{ text }</span>
		}
	</div>
}

templ GlobalAnnouncementBar(ann *models.GlobalAnnouncement) {
	if ann.URL != nil && *ann.URL != "" {
		<a
			href={ templ.SafeURL(*ann.URL) }
			class="global-announcement"
			if isExternalURL(*ann.URL) {
				target="_blank"
				rel="noopener noreferrer"
			}
		>
			@announcementTrack(ann.Text)
		</a>
	} else {
		<div class="global-announcement">
			@announcementTrack(ann.Text)
		</div>
	}
}
