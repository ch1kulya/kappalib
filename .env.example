# Always required
DATABASE_URL=postgresql://user:password@localhost:5432/database?sslmode=disable
ALLOWED_ORIGIN=origin
AUTH_SECRET=secret
AUTH_URL=http://localhost:1666
AUTH_SECURE=true

# Сan be random/dummy data in dev
PHARE_TOKEN=phare_api_token
PHARE_ID=phare_id
TURNSTILE_COMMENTS_SITE_KEY=key
TURNSTILE_COMMENTS_SECRET=secret
SMARTCAPTCHA_SITE_KEY=ysc1_key
SMARTCAPTCHA_SECRET=ysc2_secret
TELEGRAM_BOT_TOKEN=secret
TELEGRAM_CHAT_ID=admin_id
TELEGRAM_WEBHOOK_SECRET=secret
GITHUB_TOKEN=github_token
S3_ENDPOINT=endpoint
S3_BUCKET=name
S3_ACCESS_KEY=key
S3_SECRET_KEY=secret
S3_USE_SSL=true
S3_PUBLIC_URL=url
INDEX_NOW_KEY=key

# Сan be ignored in dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Can be ignored in prod
API_TOKEN=internal_secret_api_token
SHOW_USER_AGENT=false
